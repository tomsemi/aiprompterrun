---
import { primaryActions } from "../data/site";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Floating teleprompter above apps</p>
    <h1>Read your script while the camera app stays open.</h1>
    <p class="lede">
      AIPrompter keeps your words floating over recording, livestream, and meeting apps so you
      can stay on lens, keep pace, and record without switching screens.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={primaryActions.download.href}>
        {primaryActions.download.label}
      </a>
      <a class="button button-secondary" href={primaryActions.remote.href}>
        {primaryActions.remote.label}
      </a>
    </div>
    <div class="hero-meta">
      <span>Float over camera apps</span>
      <span>Apple Watch and web remote</span>
      <span>Built for creator workflows</span>
    </div>
  </div>
  <div class="hero-stage">
    <div class="device-cluster">
      <div class="device-frame prompter-device">
        <div class="device-label">CAMERA APP</div>
        <div class="device-screen camera-screen">
          <div class="camera-preview">
            <span class="camera-dot"></span>
            <span class="lens-ring"></span>
            <div class="floating-script-card">
              <span>Floating script</span>
              <strong>Stay calm, keep eye contact, and deliver the next line naturally.</strong>
              <div class="script-progress"><i></i></div>
            </div>
            <div class="app-dock">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
      </div>
      <div class="device-frame remote-device">
        <div class="device-label">REMOTE</div>
        <div class="device-screen remote-screen">
          <div class="remote-chip">ROOM E8Z80P</div>
          <div class="remote-grid">
            <span>⏪</span>
            <span>▶</span>
            <span>⏩</span>
            <span>🐢</span>
            <span>🐇</span>
            <span>↩</span>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-panel">
      <div>
        <strong>Float while recording</strong>
        <p>Keep the script visible while the app you record in stays front and center.</p>
      </div>
      <div>
        <strong>Remote when needed</strong>
        <p>Use another device to adjust speed when your main screen should stay untouched.</p>
      </div>
    </div>
  </div>
</section>
