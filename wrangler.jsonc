{
  "name": "aiprompterrun",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-05",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "aiprompter.run", "custom_domain": true },
    { "pattern": "www.aiprompter.run", "custom_domain": true },
    { "pattern": "remote.aiprompter.run", "custom_domain": true },
    { "pattern": "teleprompter.chatutil.top", "custom_domain": true },
    { "pattern": "remote.chatutil.top", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["RoomDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
